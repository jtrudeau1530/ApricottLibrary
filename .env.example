# Host identity
TZ=America/New_York
PUID=1000
PGID=1000

# ---- Public origin ----
# Single domain that fronts both the SvelteKit frontend (`/`) and the FastAPI sidecar (`/api`).
PUBLIC_APP_URL=https://library.zektek.us

# ---- Jellyfin ----
JELLYFIN_URL=https://library.example.com

# ---- slskd (Soulseek daemon) ----
SLSKD_USERNAME=admin
SLSKD_PASSWORD=change-me-strong-password
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=

# ---- Shared media path ----
MEDIA_PATH=./media

# ---- Downloads staging path ----
DOWNLOADS_PATH=./downloads

# ---- Sidecar — Spotify Web API ----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://library.zektek.us/api/auth/spotify/callback

# ---- Postgres (app-state for users, sessions, queue, playlists) ----
POSTGRES_USER=apricot
POSTGRES_PASSWORD=apricot-dev-only-change-me
POSTGRES_DB=apricot
# Used by the sidecar as the async SQLAlchemy DSN.
DATABASE_URL=postgresql+psycopg://apricot:apricot-dev-only-change-me@postgres:5432/apricot

# ---- Master admin (created on first sidecar boot) ----
APRICOT_ADMIN_USERNAME=admin
APRICOT_ADMIN_PASSWORD=change-me-on-first-boot

# ---- Session cookie ----
SESSION_COOKIE_NAME=apricot_session
# Set to false ONLY for local dev over plain http. Production = true.
SESSION_COOKIE_SECURE=true

# ---- Jellyfin REST API ----
# Internal Docker DNS; the browser never sees this.
JELLYFIN_INTERNAL_URL=http://jellyfin:8096
# Create in Jellyfin → Dashboard → Advanced → API Keys.
JELLYFIN_API_KEY=REPLACE_WITH_JELLYFIN_API_KEY

# ---- Frontend (SvelteKit) ----
# 32-byte hex string. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# ---- AI station maker (backend runtime only) ----
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Set securely in ignored .env or deployment secrets; never in frontend config.
AI_API_KEY=
AI_MAX_COMPLETION_TOKENS=2048
AI_TIMEOUT_SECONDS=45
ACQUISITION_CONCURRENCY=2
ACQUISITION_MAX_ATTEMPTS=3
ACQUISITION_TIMEOUT_SECONDS=300
STATION_IMPORT_ATTEMPTS=20
# Verified alias on the deployed shared Coolify network, not local Docker DNS.
RADIO_INTERNAL_URL=http://radio-engine:8000
# Dedicated random secret; must match Radio's backend RADIO_LIBRARY_TOKEN.
RADIO_LIBRARY_TOKEN=
RADIO_PUBLIC_URL=https://radio.zektek.us
