# Host identity
TZ=America/New_York
PUID=1000
PGID=1000

# ---- Jellyfin ----
# Public URL Jellyfin advertises (used by clients for redirects, autodiscovery, etc.)
JELLYFIN_URL=https://library.example.com

# ---- slskd (Soulseek daemon) ----
# Web UI / REST API basic auth. The web UI is served at the Coolify domain
# you map to this service (e.g. https://slskd.zektek.us). Change the password.
SLSKD_USERNAME=admin
SLSKD_PASSWORD=change-me-strong-password

# Soulseek network credentials. Sign up free at https://www.slsknet.org/news/
# These are the credentials slskd uses to log in to the Soulseek P2P network.
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=

# ---- Shared media path ----
# Host path that holds the music library. The Apricot Radio service MUST mount
# this same path so it can read files Library has written.
# On Coolify: bind to a stable path like /data/apricot/media.
MEDIA_PATH=./media

# ---- Downloads staging path ----
# Host path slskd downloads land in. KEPT SEPARATE from MEDIA_PATH on purpose:
# Soulseek downloads have inconsistent tags/filenames and should be curated by
# the future download sidecar before being moved into MEDIA_PATH.
# On Coolify: bind to a stable path like /data/apricot/downloads.
DOWNLOADS_PATH=./downloads

# ---- Sidecar (Spotify search + downloader API) ----
# Spotify Web API app credentials. Create a free app at
# https://developer.spotify.com/dashboard — Client Credentials flow is enough
# for the /search endpoint. Add a redirect URI later for OnTheSpot auth.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
